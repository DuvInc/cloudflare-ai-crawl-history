# Only the local scripts read this file. The Worker gets its token as a
# secret (`npx wrangler secret put CF_ANALYTICS_TOKEN`, or bin/create-token.sh)
# and never sees this file.
#
#   cp .env.example .env
#
# `.env` is gitignored. A real environment variable always wins over the file.

# Optional. Lets `npm run preflight` test the exact token you are about to
# deploy: Zone > Zone > Read and Zone > Analytics > Read on each site, nothing
# else. Read-only, free to use: the GraphQL API does not bill per query, it
# rate-limits at 300 queries per 5 minutes. Leave it empty if you set the
# secret with bin/create-token.sh, which tests the token itself.
CF_ANALYTICS_TOKEN=
